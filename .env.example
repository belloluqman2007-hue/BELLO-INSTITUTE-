# ============================================================================
# MULTI-MADRASA PLATFORM — ENVIRONMENT VARIABLES TEMPLATE
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
#  *** NEVER COMMIT A REAL .env FILE. ***  Only this .env.example is committed.
#  *** NEVER COPY VALUES FROM THE OLD/PRODUCTION .env. ***
#  Every value below is a PLACEHOLDER or a safe development default.
#
# The app REFUSES TO START if required production values are missing, so a
# misconfigured deployment can never silently reuse someone else's database.
# ============================================================================


# ----------------------------------------------------------------------------
# SECTION 1 — NODE / APP
# ----------------------------------------------------------------------------
# development  |  production
NODE_ENV=development

# Port the Node server binds to. Render/Railway inject PORT automatically.
PORT=3000

# Public base URL of the FRONTEND. Used for canonical tags and absolute links.
# development: blank (auto-detect)   |   production: https://your-new-domain
# NOTE: must be a NEW domain. Do NOT put the old production domain here.
PUBLIC_URL=

# Base URL of the API as seen by the browser.
#   blank (default) -> same-origin /api  (the normal case: this server also
#                      serves the frontend, so the SPA just calls "/api")
#   set a full URL  -> only if the API is hosted on a SEPARATE origin, e.g.
#                      https://api.your-new-domain
# This is served to the frontend at runtime via /app-config.js — the value is
# NEVER hard-coded in the app or the old production URL.
API_BASE_URL=


# ----------------------------------------------------------------------------
# SECTION 2 — DATABASE
# ----------------------------------------------------------------------------
# Two drivers are supported. Pick ONE by setting DATABASE_DRIVER.
#
#   DATABASE_DRIVER=sqlite  -> file-based dev database (zero-config)
#   DATABASE_DRIVER=mysql   -> a brand-NEW MySQL/MariaDB database (production)
#
# The app only ever touches the database named below. It will not open the
# old production database; that database is not referenced anywhere in code.

# development default:
DATABASE_DRIVER=sqlite
# Path to the SQLite file (dev only). Parent dir is created automatically.
DATABASE_FILE=./data/madrasa_platform_dev.sqlite

# --- Production (MySQL) — create a NEW database first, see docs/DATABASE.md ---
# DATABASE_DRIVER=mysql
# A full connection string to the NEW database. Format:
#   mysql://NEW_USER:NEW_PASSWORD@NEW_HOST:3306/NEW_DB_NAME
# Example (placeholders only):
# DATABASE_URL=mysql://mm_user:CHANGE_ME_STRONG_PASSWORD@db.internal:3306/madrasa_platform_prod

# Individual vars (used if DATABASE_URL is blank):
# DB_HOST=
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=madrasa_platform_prod
# DB_SSL=true


# ----------------------------------------------------------------------------
# SECTION 3 — AUTHENTICATION / SECRETS  (generate NEW ones, never reuse old)
# ----------------------------------------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# Signs the session cookie and CSRF tokens. REQUIRED in production.
SESSION_SECRET=CHANGE_ME__generate_a_long_random_string__at_least_32_chars

# Super-admin bootstrap. On a completely fresh database the first run creates
# ONE super admin using these values, then the seed is inert. Pick a strong
# password and CHANGE it after first login.
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=CHANGE_ME__choose_a_strong_password

# Session lifetime (hours).
SESSION_MAX_AGE_HOURS=12


# ----------------------------------------------------------------------------
# SECTION 4 — CORS  (only if the frontend is hosted on a different origin)
# ----------------------------------------------------------------------------
# Comma-separated list of allowed origins. Leave blank for same-origin (the
# normal case — the Node server also serves the frontend).
# CORS_ORIGINS=


# ----------------------------------------------------------------------------
# SECTION 5 — RATE LIMITING
# ----------------------------------------------------------------------------
# Max login attempts per (IP + username) per 15 minutes. Per-account so one
# shared office IP doesn't starve other users, while still blocking brute force.
LOGIN_RATE_LIMIT=10
# Max general API requests per IP per 15 minutes.
API_RATE_LIMIT=300


# ----------------------------------------------------------------------------
# SECTION 6 — OPTIONAL FEATURES  (all disabled unless explicitly enabled)
# ----------------------------------------------------------------------------
# --- AI assistant (opt-in; leave blank to disable; no default provider) ---
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=

# --- File uploads ---
UPLOAD_DIR=./uploads

# ---------------------------------------------------------------------------
# PERSISTENCE — where everything the app writes to disk lives
# ---------------------------------------------------------------------------
# DATA_DIR holds the dev SQLite file, the uploads and the JSON backups. On
# hosts with an ephemeral container filesystem (Render without a disk, Railway
# or Fly without a volume, a plain `docker run`) EVERYTHING in it is deleted on
# the next deploy — that is how "I created a madrasa and it disappeared"
# happens. Mount a volume and point DATA_DIR at it. docs/PERSISTENCE.md.
DATA_DIR=./data
# Where the app looks for your mounted volume when judging persistence.
PERSISTENT_VOLUME_DIR=/var/data
# UPLOAD_DIR=${DATA_DIR}/uploads
# BACKUP_DIR=${DATA_DIR}/backups
# Write a JSON snapshot of every table this often (minutes, 0 = never).
# A snapshot is also taken before each migration, before each restore, and on
# a graceful shutdown. `npm run backup` writes one by hand;
# `npm run backup -- --restore <file> --dry-run` previews a recovery.
BACKUP_INTERVAL_MINUTES=360
BACKUP_KEEP=10
# Set to 1 only when you have checked that this disk survives restarts (a VPS
# with the data directory on the machine's own volume). Silences the storage
# warnings; backups keep running either way.
DATA_PERSISTENT_ACK=0

# ---------------------------------------------------------------------------
# PUBLIC SITE (viewable without logging in)
# ---------------------------------------------------------------------------
# Directory/profile/notices reads, and separately the two write paths, so a
# crawler cannot fill the admission queue or brute-force result checking.
PUBLIC_RATE_LIMIT=600        # logged-out reads per IP per 15 minutes
PUBLIC_APPLY_LIMIT=8         # admission submissions per IP per hour
PUBLIC_VERIFY_LIMIT=12       # result verifications per IP+madrasa per 15 minutes
# (API_RATE_LIMIT defaults to 300/15min in production and 5000 in development,
#  so test/smoke.sh is never throttled while you are working locally.)
MAX_UPLOAD_MB=5
